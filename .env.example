# AdaptLearn Student Web production skeleton
# Copy to apps/web/.env.local and apps/api/.env for local development.
# Do not commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://aiczvdicexzwvkqpqncu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FOUNDATION_API_BASE_URL=http://127.0.0.1:8000

SUPABASE_URL=https://aiczvdicexzwvkqpqncu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
SUPABASE_REGION=ap-northeast-1
SUPABASE_ENABLE_PGVECTOR=true

OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_FALLBACK_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_FALLBACK_MODEL=gpt-4o-transcribe

LMS_BASE_URL=
LMS_CLIENT_ID=
LMS_CLIENT_SECRET=
LMS_TOKEN_URL=
LMS_WEBHOOK_SECRET=

REDIS_URL=redis://127.0.0.1:6379/0

ADAPTLEARN_DEV_MOCK_AUTH=true
MOCK_DATA_RETENTION_DAYS=7
